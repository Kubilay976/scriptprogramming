clc;
clear;
close all;

%% 1(a) First 3D surface plot

x = -2:0.05:2;
y = -2:0.05:2;
[X, Y] = meshgrid(x, y);

Z = sin(abs(X + Y) ./ 20) .* exp(-abs(X + Y));

figure;
surf(X, Y, Z);
shading interp;
colormap(jet);
xlabel('x');
ylabel('y');
zlabel('f(x,y)');
title('First Surface Plot');
view(90, 30);
grid on;
axis tight;

%% 1(b) Second 3D surface plot using polar coordinates

r = 0:0.05:3;
theta = 0:pi/90:2*pi;
[R, T] = meshgrid(r, theta);

X = R .* cos(T);
Y = R .* sin(T);
Z = 1 - 2 .* X.^2 - 3 .* Y.^2;

figure;
surf(X, Y, Z);
shading interp;
colormap(parula);
xlabel('x');
ylabel('y');
zlabel('f(x,y)');
title('Second Surface Plot');
view(45, 30);
grid on;
axis tight;

%% 2(a) Surface with camlight effect

x = -1.5:0.05:1.5;
y = -1.5:0.05:1.5;
[X, Y] = meshgrid(x, y);

Z = 1 - (X.^2 + Y.^2);

figure;
surf(X, Y, Z);
shading interp;
colormap(parula);
lighting gouraud;
camlight('headlight');
xlabel('x');
ylabel('y');
zlabel('z');
title('Surface with Camlight');
grid on;
axis tight;
view(45, 30);

%% 2(b) Surface with contour lines

figure;
surf(X, Y, Z);
shading interp;
colormap(parula);
hold on;
contour3(X, Y, Z, 15, 'k', 'LineWidth', 0.8);
hold off;
xlabel('x');
ylabel('y');
zlabel('z');
title('Surface with Contour Lines');
grid on;
axis tight;
view(45, 30);

%% 2(c) Semi-transparent surface

figure;
surf(X, Y, Z, 'FaceAlpha', 0.5);
shading interp;
colormap(jet);
xlabel('x');
ylabel('y');
zlabel('z');
title('Semi-transparent Surface');
grid on;
axis tight;
view(45, 30);

