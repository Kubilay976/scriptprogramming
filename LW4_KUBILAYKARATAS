clear; clc; close all;

%% 1(a)
[x,y] = meshgrid(linspace(-2,2,100));
z = sin(abs(x+y)/20).*exp(-abs(x+y));

figure;
surf(x,y,z,'FaceColor','b');
xlabel('X'); ylabel('Y'); zlabel('Z');
title('Surface Function 1');
view(90,0);

%% 1(b)
[r,t] = meshgrid(linspace(0,3,100),linspace(0,2*pi,100));
x = r.*cos(t);
y = r.*sin(t);
z = 1-2*x.^2-3*y.^2;

figure;
surf(x,y,z,'FaceColor','r');
xlabel('X'); ylabel('Y'); zlabel('Z');
title('Surface Function 2');
view(45,30);

%% 2(a) Camlight
[x,y] = meshgrid(linspace(-1,1,100));
z = 1-(x.^2+y.^2);

figure;
surf(x,y,z);
title('Camlight Effect');
xlabel('X'); ylabel('Y'); zlabel('Z');
camlight; lighting gouraud;

%% 2(b) Contour lines
figure;
surf(x,y,z);
hold on;
contour3(x,y,z,15,'k');
title('Surface with Contour Lines');
xlabel('X'); ylabel('Y'); zlabel('Z');
hold off;

%% 2(c) Semitransparent surface
figure;
surf(x,y,z,'FaceAlpha',0.5);
title('Semitransparent Surface');
xlabel('X'); ylabel('Y'); zlabel('Z');

