% 3. Practical applications
t = 0:0.002:1.2;
A = 5;
f = 6;
sigma = 1.5;
U1 = 3;
U2 = 2;

s = A*sin(2*pi*f*t) + 0.5*A*cos(4*pi*f*t);
n = sigma*randn(size(t));
s = s + n;

x = s(s > U1);
sf = s;
sf(abs(sf) < U2) = 0;

disp('Selected samples:')
disp(x)
disp('Number of selected samples:')
disp(sum(s > U1))
disp('Number of samples:')
disp(numel(s))
disp('Minimum filtered voltage:')
disp(min(sf))
disp('Maximum filtered voltage:')
disp(max(sf))

